# Local sandbox only. Run python3 scripts/bootstrap.py to generate unique keys.
RUNTIME_DATABASE_URL=postgresql+asyncpg://runtime:runtime@localhost:5432/runtime
RUNTIME_API_KEY=
RUNTIME_APPROVAL_KEY=
RUNTIME_WEBHOOK_SECRET=
RUNTIME_TOOL_API_TOKEN=
RUNTIME_TOOL_BASE_URL=http://sandbox:8001
RUNTIME_ALLOW_LOCAL_SANDBOX=true
RUNTIME_ALLOWED_TOOLS=["lookup_customer","upsert_ticket","send_notification","refund_payment"]
RUNTIME_MODEL_PROVIDER=fake
# Optional: set provider=openai and supply BOTH variables. No live API use is required.
RUNTIME_OPENAI_API_KEY=
RUNTIME_OPENAI_MODEL=
