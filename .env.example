# Local sandbox only. Run python3 scripts/bootstrap.py to generate unique keys.
RUNTIME_DATABASE_URL=postgresql+asyncpg://runtime:runtime@localhost:5432/runtime
RUNTIME_API_KEY=
RUNTIME_APPROVAL_KEY=
RUNTIME_OPERATOR_KEY=
RUNTIME_WEBHOOK_SECRET=
RUNTIME_TOOL_API_TOKEN=
RUNTIME_TOOL_BASE_URL=http://sandbox:8001
RUNTIME_ALLOW_LOCAL_SANDBOX=true
RUNTIME_ALLOWED_TOOLS=["lookup_customer","upsert_ticket","send_notification","refund_payment"]
RUNTIME_MODEL_PROVIDER=fake
# Optional: set provider=openai and supply BOTH variables. No live API use is required.
RUNTIME_OPENAI_API_KEY=
RUNTIME_OPENAI_MODEL=
RUNTIME_TENANTS=[]
RUNTIME_TENANT_QUEUE_CAPACITY=1000
RUNTIME_TENANT_ADMISSIONS_PER_MINUTE=120
RUNTIME_RECONCILIATION_ATTEMPTS=3
RUNTIME_RECONCILIATION_SECONDS=3600
RUNTIME_RECONCILIATION_BACKOFF_SECONDS=5
RUNTIME_WORKER_DRAIN_SECONDS=30
RUNTIME_RECOVERY_READ_ONLY=false
# Optional GitHub provider. Set these through secret/config injection, never chat.
# RUNTIME_GITHUB_TOKEN=
# RUNTIME_GITHUB_ACTOR=example-bot
# RUNTIME_GITHUB_REPOSITORY=example-owner/example-repo
# Add create_issue to the appropriate tenant tool policy only after configuration.
